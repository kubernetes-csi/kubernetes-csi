# Mark auto-generated content so GitHub collapses it in PR reviews and excludes
# it from language statistics (linguist-generated).

# Assembly area / synced upstream code. These rules keep generated content
# collapsed if these currently ignored paths are committed in the future.
# sync.sh mirrors *every* non-test .go
# file from pkg/<sidecar>/cmd/csi-<sidecar>/ into cmd/csi-sidecars/, so match the
# whole tree rather than the filenames that happen to exist today.
pkg/**      linguist-generated=true
staging/**  linguist-generated=true
cmd/**      linguist-generated=true

# Exceptions: these assembly-area paths are symlinks to the hand-maintained
# source of truth under tools/.
cmd/csi-sidecars/main.go                            -linguist-generated
cmd/csi-sidecars/main_test.go                       -linguist-generated
cmd/csi-sidecars/config/flags.go                    -linguist-generated
cmd/csi-sidecars/config/flags_test.go               -linguist-generated
pkg/attacher/cmd/csi-attacher/main.go               -linguist-generated
pkg/attacher/cmd/csi-attacher/config/flags.go       -linguist-generated
pkg/attacher/cmd/csi-attacher/config/flags_test.go  -linguist-generated
